<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <neuronaptiq_search>
            <general>
                <search>0</search>
                <categories>0</categories>
                <crosssellings>0</crosssellings>
                <crosssellings_limit>8</crosssellings_limit>
                <crosssellings_kind>related</crosssellings_kind>
                <upsell_kind>off</upsell_kind>
